# Database - PostgreSQL via Prisma with @prisma/adapter-pg
DATABASE_URL="postgresql://user:password@localhost:5432/festify"
# Use a separate database for tests if available - tests prefer TEST_DATABASE_URL, fallback to DATABASE_URL
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/festify_test"

# Authentication - JWT secret must be strong, at least 32 chars
JWT_SECRET="change-me-to-a-strong-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# Server
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Node env
NODE_ENV="development"
